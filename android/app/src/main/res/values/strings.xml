    <!-- AuthView -->
    <string name="auth_header_suffix">" // SECURE TERMINAL"</string>
    <!-- docs/DECOY-ACCOUNT.md §5: the screen asserts nothing. A container exists from first run and
         no path deletes it, so the app cannot tell whether this device holds an account. The two
         sentences that used to live here — "an identity lives on this device" and "no identity on
         this device yet" — are DELETED, not merely unused: a forbidden claim left in the resource
         table is one @string away from being rendered again. -->
    <!-- docs/DECOY-ACCOUNT.md §1, "Creating an identity from cold". Shown EVERY TIME, whatever the
         app knows: a warning that appeared only when something was there would answer the question
         this whole design exists to leave unanswered. One that always appears carries no
         information at all — and because a cold create rewrites the WHOLE container, it is not a
         probability the reader has to weigh but a plain statement of what will happen. -->
    <string name="dlg_create_slot">ERASES THIS DEVICE</string>
    <string name="dlg_create_slot_msg">creating an identity here erases anything else stored on this device.\n\nif you already have an identity on this device, sign in first — from inside an account nothing is risked.</string>
    <string name="btn_create_anyway">CREATE</string>
    <string name="auth_choose_neutral">this device may or may not hold an identity — only a password can say.</string>
    <string name="auth_btn_sign_in">[ SIGN IN ]</string>
    <string name="auth_btn_create_identity">[ CREATE IDENTITY ]</string>
    <string name="auth_btn_restore_backup">[ RESTORE BACKUP ]</string>
    <string name="auth_choose_footnote">identities exist only on the device that created them — unless you carry an encrypted backup (made in [cfg]) to the new device. no cloud account, no email, no server-side recovery.</string>
    <!-- docs/DECOY-ACCOUNT.md §5: this is now the FIRST line of the app, so it must not presume
         the reader already has a password any more than it may presume this device holds an
         identity. It says the same words on a phone that has never held an account, on one
         holding two, and on one wiped ten minutes ago. -->
    <string name="auth_signin_prompt">> enter a password to open what is on this device</string>
    <string name="auth_field_password">password:</string>
    <string name="auth_btn_unlock">[ UNLOCK ]</string>
    <string name="auth_err_enter_password">enter a password</string>
    <!-- The way out of the form, for the one launch in a thousand that is not a sign-in. Worded as
